# 构建产物
firmware/build/
firmware/.cache/
sim/build/

# 由 sdkconfig.defaults 重新生成，不入库（新克隆时 defaults 会干净地套用）
firmware/sdkconfig

# 组件由 main/idf_component.yml + dependencies.lock 自动拉取
firmware/managed_components/

# 字体生成工具的依赖：cd tools && npm install
tools/node_modules/

# 模拟器运行期存档（两个轮换槽位）
travel_frog_save.bin
travel_frog_save.bak
*.orig

# 截图脚本的输出
tools/shots/
tools/*.png

__pycache__/
*.pyc
.vscode/

# 宿主机单元测试的产物（tests/test_core.c，见文件头部的编译命令）
tests/*.exe
tests/*.obj
tests/*.pdb

# 套皮（reskin）工作区：素材取自 X26_Client 的 Act111 像素库，属于商业项目的资源，
# 计划书里也写了内部资源的绝对路径，两者都不入库。
docs/reskin/
docs/reskin_plan.md
